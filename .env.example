# Copy this file to .env.local for local development.
# Never commit real DATABASE_URL or VAPID secret values.

# Leave empty to use local SQLite via DB_PATH.
DATABASE_URL=
DB_PATH=real_estate-v2.db
# Keep v2 commercial data separate from the original residential app in Neon.
DB_SCHEMA=commercial_v2

# For production/Render, set DATABASE_URL in the hosting dashboard instead.
ENABLE_SCHEDULER=false
ENABLE_CRAWL_ENDPOINT=false
SEED_DEMO_DATA=false
ALLOW_DEMO_FALLBACK=false
SKIP_STARTUP_BACKFILL=true
LOCAL_CRAWL_SCHEDULE_HOUR=10
LOCAL_CRAWL_SCHEDULE_MINUTE=0
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=3
DB_POOL_TIMEOUT=10
PGCONNECT_TIMEOUT=10

# Optional Web Push settings.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
